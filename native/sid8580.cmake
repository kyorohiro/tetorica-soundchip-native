# SPDX-License-Identifier: BSD-3-Clause
# Included only when TETORICA_ENABLE_SID8580=ON. No Cargo, fetch or player CPU.
find_program(TETORICA_SID8580_RUSTC NAMES rustc REQUIRED)
set(TETORICA_SID8580_RUST_TARGET "" CACHE STRING "Rust target triple for the optional SID 8580 static library")
set(TETORICA_SID8580_RUST_FLAGS "" CACHE STRING "Additional semicolon-separated rustc flags for SID 8580 (for example CRT policy)")
set(_sid8_root "${TETORICA_SDK_ROOT}")
set(_sid8_out "${CMAKE_CURRENT_BINARY_DIR}/sid8580-rust")
file(MAKE_DIRECTORY "${_sid8_out}")
execute_process(COMMAND "${TETORICA_SID8580_RUSTC}" -vV
  OUTPUT_VARIABLE _sid8_version RESULT_VARIABLE _sid8_status)
if(NOT _sid8_status EQUAL 0 OR NOT _sid8_version MATCHES "host: ([^\r\n]+)")
  message(FATAL_ERROR "SID 8580 requires a working rustc installation")
endif()
set(_sid8_host "${CMAKE_MATCH_1}")
set(_sid8_target "${TETORICA_SID8580_RUST_TARGET}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
  list(LENGTH CMAKE_OSX_ARCHITECTURES _sid8_arch_count)
  if(NOT _sid8_arch_count EQUAL 1)
    message(FATAL_ERROR "SID 8580: build each macOS architecture separately; combine finished archives for a universal distribution")
  endif()
endif()
if(NOT _sid8_target)
  if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    if(CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
      set(_sid8_target aarch64-apple-darwin)
    elseif(CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
      set(_sid8_target x86_64-apple-darwin)
    endif()
  endif()
  if(NOT _sid8_target)
    if(CMAKE_CROSSCOMPILING)
      message(FATAL_ERROR "Set TETORICA_SID8580_RUST_TARGET to the C/C++ target triple and install its Rust standard library before a cross build")
    endif()
    set(_sid8_target "${_sid8_host}")
  endif()
endif()
# Match the C/C++ destination, not merely the host that happens to run rustc.
# In particular a Visual Studio -A ARM64 build can have an AMD64 host processor.
set(_sid8_c_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
  set(_sid8_c_arch "${CMAKE_OSX_ARCHITECTURES}")
elseif(CMAKE_GENERATOR_PLATFORM)
  string(REGEX REPLACE ",.*$" "" _sid8_c_arch "${CMAKE_GENERATOR_PLATFORM}")
elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
  set(_sid8_c_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
elseif(CMAKE_CXX_COMPILER_TARGET)
  string(REGEX REPLACE "-.*$" "" _sid8_c_arch "${CMAKE_CXX_COMPILER_TARGET}")
endif()
string(TOLOWER "${_sid8_c_arch}" _sid8_c_arch)
if(_sid8_c_arch MATCHES "^(amd64|x64|x86_64)$")
  set(_sid8_c_arch x86_64)
elseif(_sid8_c_arch MATCHES "^(arm64|aarch64)$")
  set(_sid8_c_arch aarch64)
elseif(_sid8_c_arch MATCHES "^(win32|x86|i[3-6]86)$")
  set(_sid8_c_arch i686)
elseif(_sid8_c_arch MATCHES "^(arm|armv7.*)$")
  set(_sid8_c_arch armv7)
endif()
string(REGEX REPLACE "-.*$" "" _sid8_rust_arch "${_sid8_target}")
if(_sid8_rust_arch MATCHES "^armv7")
  set(_sid8_rust_arch armv7)
endif()
if(NOT _sid8_c_arch STREQUAL _sid8_rust_arch)
  message(FATAL_ERROR "SID 8580 architecture mismatch: C/C++ ${_sid8_c_arch}, Rust ${_sid8_target}")
endif()
if(APPLE AND NOT _sid8_target MATCHES "-apple-darwin$")
  message(FATAL_ERROR "SID 8580 macOS requires an apple-darwin Rust target")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT _sid8_target MATCHES "-linux-")
  message(FATAL_ERROR "SID 8580 Linux requires a matching Linux Rust target")
endif()
if(WIN32)
  if(MSVC AND NOT _sid8_target MATCHES "-windows-msvc$")
    message(FATAL_ERROR "SID 8580 requires a windows-msvc Rust target with an MSVC C/C++ build")
  elseif(MINGW AND NOT _sid8_target MATCHES "-windows-gnu$")
    message(FATAL_ERROR "SID 8580 requires a windows-gnu Rust target with a MinGW C/C++ build")
  endif()
  if(CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT _sid8_target MATCHES "^(x86_64|aarch64)-")
    message(FATAL_ERROR "SID 8580 Rust and C/C++ pointer widths must match")
  elseif(CMAKE_SIZEOF_VOID_P EQUAL 4 AND NOT _sid8_target MATCHES "^(i686|armv7)-")
    message(FATAL_ERROR "SID 8580 Rust and C/C++ pointer widths must match")
  endif()
endif()
set(_sid8_flags --edition=2021 -C opt-level=3 -C panic=abort -C codegen-units=1
  -C relocation-model=pic --remap-path-prefix "${_sid8_root}=tetorica"
  --target "${_sid8_target}" ${TETORICA_SID8580_RUST_FLAGS})

# Ask the selected Rust toolchain for its actual platform libraries instead of
# hard-coding Linux, Darwin, MSVC or MinGW dependencies. A tiny local staticlib
# query needs the installed target std only; it performs no network access.
file(WRITE "${_sid8_out}/link-probe.rs" "#[no_mangle] pub extern \"C\" fn tetorica_sid8580_link_probe() {}\n")
execute_process(COMMAND "${TETORICA_SID8580_RUSTC}" ${_sid8_flags}
  --crate-name tetorica_sid8580_link_probe --crate-type staticlib --print native-static-libs
  "${_sid8_out}/link-probe.rs" -o "${_sid8_out}/link-probe${CMAKE_STATIC_LIBRARY_SUFFIX}"
  RESULT_VARIABLE _sid8_status OUTPUT_VARIABLE _sid8_stdout ERROR_VARIABLE _sid8_stderr)
if(NOT _sid8_status EQUAL 0)
  message(FATAL_ERROR "SID 8580 Rust target ${_sid8_target} cannot build. Install its standard library/toolchain before configuring.\n${_sid8_stdout}\n${_sid8_stderr}")
endif()
if(NOT "${_sid8_stdout}\n${_sid8_stderr}" MATCHES "native-static-libs: ([^\r\n]+)")
  message(FATAL_ERROR "rustc did not report the SID 8580 native static-library dependencies")
endif()
separate_arguments(_sid8_system_libs NATIVE_COMMAND "${CMAKE_MATCH_1}")
if(MSVC)
  # rustc versions report either native .lib names or GNU-shaped -l names for
  # MSVC. Pass ordinary library names to CMake rather than GNU switches to LINK.
  set(_sid8_msvc_libs)
  foreach(_sid8_lib IN LISTS _sid8_system_libs)
    if(_sid8_lib MATCHES "^-l:(.+)$")
      list(APPEND _sid8_msvc_libs "${CMAKE_MATCH_1}")
    elseif(_sid8_lib MATCHES "^-l(.+)$")
      list(APPEND _sid8_msvc_libs "${CMAKE_MATCH_1}")
    else()
      list(APPEND _sid8_msvc_libs "${_sid8_lib}")
    endif()
  endforeach()
  set(_sid8_system_libs "${_sid8_msvc_libs}")
endif()
set(_sid8_sidera "${_sid8_root}/vendor/sidera/adapted/src")
file(GLOB _sid8_sources CONFIGURE_DEPENDS "${_sid8_sidera}/*.rs")
set(_sid8_rlib "${_sid8_out}/libsidera.rlib")
set(_sid8_archive "${_sid8_out}/${CMAKE_STATIC_LIBRARY_PREFIX}tetorica_sid8580${CMAKE_STATIC_LIBRARY_SUFFIX}")
add_custom_command(OUTPUT "${_sid8_rlib}" "${_sid8_archive}"
  COMMAND "${TETORICA_SID8580_RUSTC}" ${_sid8_flags} --crate-name sidera --crate-type rlib
    "${_sid8_sidera}/lib.rs" -o "${_sid8_rlib}"
  COMMAND "${TETORICA_SID8580_RUSTC}" ${_sid8_flags} --crate-name tetorica_sid8580 --crate-type staticlib
    "${_sid8_root}/vendor/tetorica-sid8580/lib.rs" --extern "sidera=${_sid8_rlib}" -o "${_sid8_archive}"
  DEPENDS ${_sid8_sources} "${_sid8_root}/vendor/tetorica-sid8580/lib.rs"
  VERBATIM COMMENT "Build the optional CPU-free Rust SID 8580 archive")
add_custom_target(tetorica_sid8580_rust_build ALL DEPENDS "${_sid8_archive}"
  SOURCES ${_sid8_sources} "${_sid8_root}/vendor/tetorica-sid8580/lib.rs")
add_library(tetorica_native_sid8580 STATIC IMPORTED GLOBAL)
set_target_properties(tetorica_native_sid8580 PROPERTIES
  IMPORTED_LOCATION "${_sid8_archive}"
  INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_LIST_DIR}/include"
  INTERFACE_COMPILE_FEATURES cxx_std_14
  INTERFACE_LINK_LIBRARIES "${_sid8_system_libs}")
add_dependencies(tetorica_native_sid8580 tetorica_sid8580_rust_build)
add_library(tetorica::sid8580 ALIAS tetorica_native_sid8580)
message(STATUS "SID 8580: ${_sid8_target}; native Rust libraries: ${_sid8_system_libs}")

if(TETORICA_NATIVE_BUILD_TESTS)
  add_executable(tetorica_sid8580_fixture "${CMAKE_CURRENT_LIST_DIR}/tests/sid8580_fixture.cpp")
  target_link_libraries(tetorica_sid8580_fixture PRIVATE tetorica::sid8580)
  if(MSVC)
    target_compile_options(tetorica_sid8580_fixture PRIVATE /EHsc /fp:strict)
  else()
    target_compile_options(tetorica_sid8580_fixture PRIVATE -ffp-contract=off)
  endif()
  add_test(NAME tetorica.sid8580.self_test COMMAND tetorica_sid8580_fixture --self-test)
endif()
if(TETORICA_NATIVE_BUILD_EXAMPLES)
  add_executable(tetorica_sid8580_wav "${CMAKE_CURRENT_LIST_DIR}/examples/sid8580_wav.cpp")
  target_link_libraries(tetorica_sid8580_wav PRIVATE tetorica::sid8580)
  if(MSVC)
    target_compile_options(tetorica_sid8580_wav PRIVATE /EHsc /fp:strict)
  else()
    target_compile_options(tetorica_sid8580_wav PRIVATE -ffp-contract=off)
  endif()
endif()
